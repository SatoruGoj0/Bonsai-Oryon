+static inline float32x4_t pq2_0_scale4(const block_pq2_0 * GGML_RESTRICT xb, const block_q8_K * GGML_RESTRICT yb) {
+    const float sc[4] = {
+        GGML_CPU_FP16_TO_FP32(xb[0].d) * yb[0].d,
+        GGML_CPU_FP16_TO_FP32(xb[1].d) * yb[0].d,
+        GGML_CPU_FP16_TO_FP32(xb[2].d) * yb[1].d,
+        GGML_CPU_FP16_TO_FP32(xb[3].d) * yb[1].d,
+    };
+    return vld1q_f32(sc);
+}
 
