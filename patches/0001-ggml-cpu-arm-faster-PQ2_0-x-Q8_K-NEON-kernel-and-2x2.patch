+#if defined(__ARM_NEON)
+// Bonsai-Oryon: PQ2_0 x Q8_K NEON kernel, de-interleaved formulation.
+//
+// Byte m of a PQ2_0 block holds the 2-bit codes of weights 4m..4m+3 (LSB pair first), weight = d * (code - 1).
+// Shifting a 16-byte load right by 0/2/4/6 (and masking) yields four vectors whose lane m holds the code of
+// weight 4m+j. VLD4 de-interleaves the matching activations the same way (val[j][m] = q8[4m+j]), so the
+// codes are paired with their activations without the TBL/SHL/AND/SUB sequence per 16 weights that the
+// previous kernel needed. The "-1" offset is folded out algebraically, using the per-16 sums Q8_K already
+// carries: sum((c-1)*y) = sum(c*y) - sum(y). Codes are 0..3 and therefore valid signed int8 SDOT operands.
+//
+// Integer block sums are exact; four blocks are scaled and accumulated per float32x4 lane, which is a
+// different (but equally valid) float summation order from the scalar reference. The nrc == 2 path below
+// uses the identical float sequence per (row, col), so batched and single-token results are bit-identical.
+
+static inline int32x4_t pq2_0_dot64(int32x4_t acc, const uint8x16_t q, const int8x16x4_t y) {
+    const uint8x16_t m3 = vdupq_n_u8(3);
+    acc = ggml_vdotq_s32(acc, vreinterpretq_s8_u8(vandq_u8(q, m3)),                y.val[0]);
+    acc = ggml_vdotq_s32(acc, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(q, 2), m3)), y.val[1]);
+    acc = ggml_vdotq_s32(acc, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(q, 4), m3)), y.val[2]);
+    acc = ggml_vdotq_s32(acc, vreinterpretq_s8_u8(vshrq_n_u8(q, 6)),               y.val[3]);
+    return acc;
+}
 
-    const block_pq2_0 * GGML_RESTRICT x = vx;
-    const block_q8_K  * GGML_RESTRICT y = vy;
-    const int nb = n / QK_PQ2_0;
+// integer sum of codes*activations over one 128-weight PQ2_0 block (offset not yet removed)
+static inline int32x4_t pq2_0_block_acc(const block_pq2_0 * GGML_RESTRICT xb, const int8_t * GGML_RESTRICT q8) {
+    int32x4_t acc = pq2_0_dot64(vdupq_n_s32(0), vld1q_u8(xb->qs), vld4q_s8(q8));
+    return pq2_0_dot64(acc, vld1q_u8(xb->qs + 16), vld4q_s8(q8 + 64));
+}
 
