+    const int32x4_t s0 = vpaddlq_s16(vld1q_s16(yb[0].bsums));
+    const int32x4_t s1 = vpaddlq_s16(vld1q_s16(yb[0].bsums + 8));
+    const int32x4_t s2 = vpaddlq_s16(vld1q_s16(yb[1].bsums));
+    const int32x4_t s3 = vpaddlq_s16(vld1q_s16(yb[1].bsums + 8));
+    return vpaddq_s32(vpaddq_s32(s0, s1), vpaddq_s32(s2, s3));
+}
 
