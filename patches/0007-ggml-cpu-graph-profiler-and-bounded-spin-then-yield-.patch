From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 17:59:53 +0000
Subject: [PATCH 7/9] ggml-cpu: graph profiler and bounded spin-then-yield
 barrier

BONSAI_PROFILE=1 prints at process exit where CPU graph time goes: per-op
compute time on thread 0 (MUL_MAT split into PQ2_0 and other weights),
per-thread compute vs barrier/imbalance wait, worker wake-up latency per
graph and graph wall time, for both the threadpool and the OpenMP build.
When disabled the cost is one predictable branch per node.

In the threadpool (non-OpenMP) build, waiters in ggml_barrier spin with the
CPU spin hint for BONSAI_BARRIER_SPIN iterations (default 4096, a few
microseconds) and then call sched_yield() between checks, so that
when there are more runnable threads than free cores (desktop load, a
throttled laptop) a spinning worker does not keep the core the late worker
needs. BONSAI_BARRIER_SPIN=-1 restores the unbounded upstream spin, 0
yields immediately.

Part of Bonsai-Oryon (https://github.com/SatoruGoj0/Bonsai-Oryon).
---
 ggml/src/ggml-cpu/ggml-cpu.c | 131 ++++++++++++++++++++++++++++++++++-
 1 file changed, 130 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 2024554..fa8f26f 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -593,6 +593,97 @@ struct ggml_state {
 
 static struct ggml_state g_state = {0};
 
+
+// ---------------------------------------------------------------------------------------------------------
+// Bonsai-Oryon: low-overhead graph profiler. BONSAI_PROFILE=1 prints, at process exit, where graph time goes:
+// per-op compute time (thread 0), per-thread compute vs barrier-wait time, worker wake-up latency and graph
+// wall time. Disabled cost: one cached branch per node. Use with e.g. `bonsai-bench -p 0 -n 64` for decoding.
+// ---------------------------------------------------------------------------------------------------------
+#define BONSAI_PROF_MAX_THREADS 64
+#define BONSAI_PROF_NKEYS (GGML_OP_COUNT + 2)   // + MUL_MAT split: PQ2_0 weights / other weights
+struct bonsai_prof_thread {
+    uint64_t compute_ns, barrier_ns, wake_ns, graphs;
+    uint8_t  pad[128 - 4 * sizeof(uint64_t)];
+};
+static struct bonsai_prof_thread bonsai_prof_t[BONSAI_PROF_MAX_THREADS];
+static uint64_t bonsai_prof_op_ns[BONSAI_PROF_NKEYS], bonsai_prof_op_n[BONSAI_PROF_NKEYS];
+static uint64_t bonsai_prof_kick_ns, bonsai_prof_wall_ns, bonsai_prof_graphs, bonsai_prof_nodes;
+static int      bonsai_prof_max_threads;
+static int      bonsai_prof_state = -1;   // -1 unknown, 0 off, 1 on
+
+static inline uint64_t bonsai_prof_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t) ts.tv_sec * 1000000000ull + (uint64_t) ts.tv_nsec;
+}
+
+static void bonsai_prof_report(void) {
+    if (bonsai_prof_graphs == 0) return;
+    const int nt = bonsai_prof_max_threads > 0 ? bonsai_prof_max_threads : 1;
+    double comp = 0, bar = 0, wake = 0; uint64_t wake_graphs = 0;
+    for (int i = 0; i < nt && i < BONSAI_PROF_MAX_THREADS; i++) {
+        comp += bonsai_prof_t[i].compute_ns; bar += bonsai_prof_t[i].barrier_ns;
+        if (i > 0) { wake += bonsai_prof_t[i].wake_ns; wake_graphs += bonsai_prof_t[i].graphs; }
+    }
+    const double wall = (double) bonsai_prof_wall_ns;
+    fprintf(stderr, "\n[bonsai-profile] %s backend, up to %d threads, %llu graphs, %.1f nodes/graph, wall %.1f ms (%.3f ms/graph)\n",
+#ifdef GGML_USE_OPENMP
+            "OpenMP",
+#else
+            "threadpool",
+#endif
+            nt, (unsigned long long) bonsai_prof_graphs, (double) bonsai_prof_nodes / bonsai_prof_graphs, wall / 1e6, wall / 1e6 / bonsai_prof_graphs);
+    fprintf(stderr, "[bonsai-profile] per thread: compute %.1f%%, barrier/imbalance wait %.1f%% of thread time; worker wake-up %.1f us/graph\n",
+            100.0 * comp / (comp + bar + 1), 100.0 * bar / (comp + bar + 1), wake_graphs ? wake / wake_graphs / 1e3 : 0.0);
+    fprintf(stderr, "[bonsai-profile] thread 0 compute by op:\n");
+    int order[BONSAI_PROF_NKEYS];
+    for (int i = 0; i < BONSAI_PROF_NKEYS; i++) order[i] = i;
+    for (int i = 0; i < BONSAI_PROF_NKEYS; i++) for (int j = i + 1; j < BONSAI_PROF_NKEYS; j++)
+        if (bonsai_prof_op_ns[order[j]] > bonsai_prof_op_ns[order[i]]) { int t = order[i]; order[i] = order[j]; order[j] = t; }
+    double tot = 0; for (int i = 0; i < BONSAI_PROF_NKEYS; i++) tot += bonsai_prof_op_ns[i];
+    for (int k = 0; k < 16; k++) {
+        const int i = order[k];
+        if (!bonsai_prof_op_n[i]) break;
+        const char * name = i == GGML_OP_COUNT ? "MUL_MAT(PQ2_0)" : i == GGML_OP_COUNT + 1 ? "MUL_MAT(other)" : ggml_op_name((enum ggml_op) i);
+        fprintf(stderr, "[bonsai-profile]   %-18s %8llu calls %10.2f ms %8.2f us/call %5.1f%%\n", name,
+                (unsigned long long) bonsai_prof_op_n[i], bonsai_prof_op_ns[i] / 1e6, bonsai_prof_op_ns[i] / 1e3 / bonsai_prof_op_n[i],
+                100.0 * bonsai_prof_op_ns[i] / (tot + 1));
+    }
+}
+
+static inline int bonsai_prof_on(void) {
+    if (__builtin_expect(bonsai_prof_state < 0, 0)) {
+        const char * e = getenv("BONSAI_PROFILE");
+        bonsai_prof_state = (e && e[0] == '1') ? 1 : 0;
+        if (bonsai_prof_state) atexit(bonsai_prof_report);
+    }
+    return bonsai_prof_state;
+}
+
+static inline int bonsai_prof_key(const struct ggml_tensor * node) {
+    if (node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) {
+        return node->src[0] && node->src[0]->type == GGML_TYPE_PQ2_0 ? GGML_OP_COUNT : GGML_OP_COUNT + 1;
+    }
+    return (int) node->op;
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// Bonsai-Oryon: bounded spin, then yield, in the threadpool barrier (non-OpenMP builds). Upstream spins without
+// bound; when there are more runnable threads than free cores (desktop load, battery throttling) a spinning
+// worker can occupy the core that the one late worker is waiting for (measured: with 2x more threads than
+// cores the unbounded spin was 10-100x slower than spin-then-yield). After BONSAI_BARRIER_SPIN iterations of
+// the CPU's spin hint (default 4096, a few microseconds on current cores) the waiter calls sched_yield()
+// between checks. -1 restores the unbounded spin, 0 yields right away.
+// ---------------------------------------------------------------------------------------------------------
+static int64_t bonsai_barrier_spin_limit = -2;
+static inline int64_t bonsai_barrier_spin(void) {
+    if (__builtin_expect(bonsai_barrier_spin_limit == -2, 0)) {
+        const char * e = getenv("BONSAI_BARRIER_SPIN");
+        bonsai_barrier_spin_limit = e && e[0] ? strtoll(e, NULL, 10) : 4096;
+    }
+    return bonsai_barrier_spin_limit;
+}
+
 void ggml_barrier(struct ggml_threadpool * tp) {
     int n_threads = atomic_load_explicit(&tp->n_graph, memory_order_relaxed) & GGML_THREADPOOL_N_THREADS_MASK;
     if (n_threads == 1) {
@@ -617,8 +708,14 @@ void ggml_barrier(struct ggml_threadpool * tp) {
     }
 
     // wait for other threads
+    const int64_t spin_limit = bonsai_barrier_spin();
+    int64_t spins = 0;
     while (atomic_load_explicit(&tp->n_barrier_passed, memory_order_relaxed) == n_passed) {
-        ggml_thread_cpu_relax();
+        if (spin_limit >= 0 && ++spins > spin_limit) {
+            sched_yield();
+        } else {
+            ggml_thread_cpu_relax();
+        }
     }
 
     // exit barrier (full seq-cst fence)
@@ -3157,6 +3254,13 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-start cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
+    const int prof = bonsai_prof_state > 0;
+    struct bonsai_prof_thread * pt = prof && state->ith < BONSAI_PROF_MAX_THREADS ? &bonsai_prof_t[state->ith] : NULL;
+    if (pt) {
+        pt->wake_ns += bonsai_prof_now() - bonsai_prof_kick_ns;
+        pt->graphs++;
+    }
+
     for (int node_n = 0; node_n < cgraph->n_nodes && atomic_load_explicit(&tp->abort, memory_order_relaxed) != node_n; node_n++) {
         struct ggml_tensor * node = cgraph->nodes[node_n];
 
@@ -3171,12 +3275,23 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
 
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
         // Try fused ops, fall back to normal compute
+        const uint64_t t_c0 = pt ? bonsai_prof_now() : 0;
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
         if (n_fused > 0) {
             node_n += n_fused;
         } else {
             ggml_compute_forward(&params, node);
         }
+        const uint64_t t_c1 = pt ? bonsai_prof_now() : 0;
+        if (pt) {
+            pt->compute_ns += t_c1 - t_c0;
+            if (state->ith == 0) {
+                const int key = bonsai_prof_key(node);
+                bonsai_prof_op_ns[key] += t_c1 - t_c0;
+                bonsai_prof_op_n[key]++;
+                bonsai_prof_nodes++;
+            }
+        }
 
         if (state->ith == 0 && cplan->abort_callback &&
                 cplan->abort_callback(cplan->abort_callback_data)) {
@@ -3186,6 +3301,7 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
 
         if (node_n + 1 < cgraph->n_nodes) {
             ggml_barrier(state->threadpool);
+            if (pt) pt->barrier_ns += bonsai_prof_now() - t_c1;
         }
     }
 
@@ -3195,7 +3311,9 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-done cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
+    const uint64_t t_b0 = pt ? bonsai_prof_now() : 0;
     ggml_barrier(state->threadpool);
+    if (pt) pt->barrier_ns += bonsai_prof_now() - t_b0;
 
 #ifdef GGML_USE_CPU_RISCV64_SPACEMIT
     ggml_backend_cpu_riscv64_spacemit_clear_numa_thread_affinity_threaded(state->ith);
@@ -3431,6 +3549,12 @@ enum ggml_status ggml_graph_compute(struct ggml_cgraph * cgraph, struct ggml_cpl
 
     bool disposable_threadpool = false;
 
+    const int prof = bonsai_prof_on();
+    if (prof) {
+        bonsai_prof_kick_ns = bonsai_prof_now();
+        if (n_threads > bonsai_prof_max_threads) bonsai_prof_max_threads = n_threads;
+    }
+
     if (threadpool == NULL) {
         //GGML_PRINT_DEBUG("Threadpool is not specified. Will create a disposable threadpool : n_threads %d\n", n_threads);
         disposable_threadpool = true;
@@ -3484,6 +3608,11 @@ enum ggml_status ggml_graph_compute(struct ggml_cgraph * cgraph, struct ggml_cpl
     ggml_graph_compute_thread(&threadpool->workers[0]);
 #endif
 
+    if (prof) {
+        bonsai_prof_wall_ns += bonsai_prof_now() - bonsai_prof_kick_ns;
+        bonsai_prof_graphs++;
+    }
+
     // don't leave affinity set on the main thread
     clear_numa_thread_affinity();
 
