 static cmd_params parse_cmd_params(int argc, char ** argv) {
+    std::string oryon_profile;
     cmd_params        params;
     std::string       arg;
     bool              invalid_param = false;
@@ -693,6 +695,12 @@ static cmd_params parse_cmd_params(int argc, char ** argv) {
                 }
                 auto p = string_split<bool>(argv[i], split_delim);
                 params.cpu_strict.insert(params.cpu_strict.end(), p.begin(), p.end());
+            } else if (arg == "--oryon-profile") {
+                if (++i >= argc) {
+                    invalid_param = true;
+                    break;
+                }
+                oryon_profile = argv[i];
             } else if (arg == "--poll") {
                 if (++i >= argc) {
                     invalid_param = true;
@@ -1164,6 +1172,24 @@ static cmd_params parse_cmd_params(int argc, char ** argv) {
     if (params.no_host.empty()) {
         params.no_host = cmd_params_defaults.no_host;
     }
+    // Bonsai-Oryon: --oryon-profile fills only -t / --poll / -C / --cpu-strict when they were not given
+    if (!oryon_profile.empty()) {
+        common_oryon_profile prof;
+        std::string err;
+        if (!common_oryon_profile_resolve(oryon_profile, prof, err)) {
+            fprintf(stderr, "error: %s\n", err.c_str());
+            exit(1);
+        }
+        if (params.n_threads.empty())  params.n_threads = { prof.n_threads };
+        if (params.poll.empty() && prof.poll >= 0) params.poll = { prof.poll };
+        if (params.cpu_mask.empty() && !prof.cpu_mask.empty()) {
+            params.cpu_mask   = { prof.cpu_mask };
+            if (params.cpu_strict.empty()) params.cpu_strict = { prof.cpu_strict };
+        }
+        if (!prof.barrier_spin.empty()) setenv("BONSAI_BARRIER_SPIN", prof.barrier_spin.c_str(), 0);
+        fprintf(stderr, "bonsai-oryon profile %s (%s): threads %d (prompt and generation tests use the same count here)\n",
+                prof.name.c_str(), prof.source.c_str(), params.n_threads[0]);
+    }
     if (params.n_threads.empty()) {
         params.n_threads = cmd_params_defaults.n_threads;
     }
