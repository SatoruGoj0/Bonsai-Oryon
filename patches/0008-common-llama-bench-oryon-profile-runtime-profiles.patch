 common/common.cpp                 | 93 +++++++++++++++++++++++++++++++
 common/common.h                   | 16 ++++++
 tools/llama-bench/llama-bench.cpp | 26 +++++++++
 4 files changed, 189 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index 94dead3..8a10d1e 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -759,6 +759,49 @@ static void common_params_apply_system_config(common_params & params, llama_exam
     }
 }
 
+// Bonsai-Oryon: --oryon-profile (or BONSAI_ORYON_PROFILE); applied after all other options, filling only
+// thread/poll/affinity settings that were not given explicitly
+static std::string g_bonsai_oryon_profile;
+
+static void bonsai_apply_oryon_profile(common_params & params, enum llama_example ex) {
+    std::string name = g_bonsai_oryon_profile;
+    if (name.empty()) {
+        const char * e = getenv("BONSAI_ORYON_PROFILE");
+        if (e && e[0]) name = e;
+    }
+    if (name.empty()) {
+        // default for the interactive tools: auto (tuned profile if present, else the balanced heuristic)
+        if (ex != LLAMA_EXAMPLE_CLI && ex != LLAMA_EXAMPLE_SERVER && ex != LLAMA_EXAMPLE_COMPLETION) return;
+        name = "auto";
+    }
+    if (name == "none") return;
+    common_oryon_profile p;
+    std::string err;
+    if (!common_oryon_profile_resolve(name, p, err)) {
+        throw std::invalid_argument(err);
+    }
+    const bool user_t  = params.cpuparams.n_threads > 0;
+    const bool user_tb = params.cpuparams_batch.n_threads > 0;
+    if (!user_t)  params.cpuparams.n_threads       = p.n_threads;
+    if (!user_tb) params.cpuparams_batch.n_threads = user_t ? params.cpuparams.n_threads : p.n_threads_batch;
+    if (p.poll >= 0) {
+        if (params.cpuparams.poll == 50)       params.cpuparams.poll       = (uint32_t) p.poll;
+        if (params.cpuparams_batch.poll == 50) params.cpuparams_batch.poll = (uint32_t) p.poll;
+    }
+    if (!p.cpu_mask.empty() && !params.cpuparams.mask_valid && !user_t) {
+        if (parse_cpu_mask(p.cpu_mask, params.cpuparams.cpumask)) {
+            params.cpuparams.mask_valid = true;
+            params.cpuparams.strict_cpu = p.cpu_strict;
+        }
+    }
+    if (!p.barrier_spin.empty()) {
+        setenv("BONSAI_BARRIER_SPIN", p.barrier_spin.c_str(), 0);
+    }
+    LOG_INF("bonsai-oryon profile %s (%s): threads %d%s, batch threads %d%s, poll %u%s\n", p.name.c_str(), p.source.c_str(),
+            params.cpuparams.n_threads, user_t ? " (from -t)" : "", params.cpuparams_batch.n_threads, user_tb ? " (from -tb)" : "",
+            params.cpuparams.poll, params.cpuparams.mask_valid ? ", cpu mask set" : "");
+}
+
