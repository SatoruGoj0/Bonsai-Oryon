+        }
+    ).set_env("BONSAI_ORYON_PROFILE"));
     add_opt(common_arg(
         {"-t", "--threads"}, "N",
         string_format("number of CPU threads to use during generation (default: %d)", params.cpuparams.n_threads),
diff --git a/common/common.cpp b/common/common.cpp
index 4045903..7553b77 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -16,6 +16,9 @@
 #include <cmath>
 #include <chrono>
 #include <cstdarg>
+#if defined(__linux__)
+#include <sched.h>
+#endif
 #include <cstring>
 #include <ctime>
 #include <filesystem>
@@ -75,6 +78,96 @@ common_time_meas::~common_time_meas() {
 // CPU utils
 //
 
+//
+// Bonsai-Oryon runtime profiles
+//
+
+int common_oryon_available_cpus() {
+#if defined(__linux__)
+    cpu_set_t set;
+    if (sched_getaffinity(0, sizeof(set), &set) == 0) {
+        const int n = CPU_COUNT(&set);
+        if (n > 0) return n;
+    }
+#endif
+    const unsigned n = std::thread::hardware_concurrency();
+    return n > 0 ? (int) n : 1;
+}
+
+static std::string common_oryon_profile_path() {
+    const char * xdg  = getenv("XDG_CONFIG_HOME");
+    const char * home = getenv("HOME");
+    if (xdg && xdg[0]) return std::string(xdg) + "/bonsai-oryon/profile";
+    if (home && home[0]) return std::string(home) + "/.config/bonsai-oryon/profile";
+    return "";
+}
+
+// tuned profile written by bonsai-tune: key=value lines; only used if it was measured on the same CPU count
+static bool common_oryon_profile_load_tuned(common_oryon_profile & out, int ncpu) {
+    const std::string path = common_oryon_profile_path();
+    if (path.empty()) return false;
+    std::ifstream f(path);
+    if (!f) return false;
+    common_oryon_profile p;
+    int file_ncpu = -1;
+    std::string line;
+    while (std::getline(f, line)) {
+        const size_t eq = line.find('=');
+        if (line.empty() || line[0] == '#' || eq == std::string::npos) continue;
+        const std::string k = line.substr(0, eq), v = line.substr(eq + 1);
+        try {
+            if      (k == "threads")       p.n_threads       = std::stoi(v);
+            else if (k == "threads_batch") p.n_threads_batch = std::stoi(v);
+            else if (k == "poll")          p.poll            = std::stoi(v);
+            else if (k == "cpu_mask")      p.cpu_mask        = v;
+            else if (k == "cpu_strict")    p.cpu_strict      = v == "1";
+            else if (k == "barrier_spin")  p.barrier_spin    = v;
+            else if (k == "ncpu")          file_ncpu         = std::stoi(v);
+        } catch (...) {
+            return false;
+        }
+    }
+    if (file_ncpu != ncpu || p.n_threads <= 0 || p.n_threads > ncpu) return false;
+    if (p.n_threads_batch <= 0 || p.n_threads_batch > ncpu) p.n_threads_batch = p.n_threads;
+    p.source = path;
+    out = p;
+    return true;
+}
+
+bool common_oryon_profile_resolve(const std::string & name, common_oryon_profile & out, std::string & err) {
+    const int ncpu = common_oryon_available_cpus();
+    // Generation threads. Measured on Snapdragon X (8 cores, desktop session): tg128 8.4 / 5.2 / 4.2 / 3.0 tok/s
+    // with 4 / 6 / 7 / 8 threads, i.e. leaving cores free for the rest of the system matters more than more
+    // threads. Small machines use all cores. bonsai-tune measures the actual machine and overrides this.
+    const int bal = ncpu <= 4 ? ncpu : std::max(4, ncpu / 2);
+    out = common_oryon_profile();
+    out.source = "built-in heuristic";
+    if (name == "auto") {
+        if (common_oryon_profile_load_tuned(out, ncpu)) {
+            out.name = "auto(tuned)";
+            return true;
+        }
+        out.name = "auto(balanced)";
+        out.n_threads = bal; out.n_threads_batch = bal; out.poll = 50;
+        return true;
+    }
+    out.name = name;
+    if (name == "balanced") {
+        out.n_threads = bal; out.n_threads_batch = bal; out.poll = 50;
+    } else if (name == "throughput") {
+        // generation as balanced, prompt/batch processing on every core
+        out.n_threads = bal; out.n_threads_batch = ncpu; out.poll = 50;
+    } else if (name == "low-power") {
+        // fewer threads, no polling between graphs, yield immediately in barriers
+        out.n_threads = std::max(1, bal / 2); out.n_threads_batch = std::max(1, bal / 2); out.poll = 0;
+        out.barrier_spin = "0";
+    } else {
+        err = "unknown --oryon-profile '" + name + "' (expected balanced, throughput, low-power or auto)";
+        return false;
+    }
+    return true;
+}
+
 int32_t common_cpu_get_num_physical_cores() {
 #if defined(_AIX)
     int32_t logical_cpus = _system_configuration.ncpus;
diff --git a/common/common.h b/common/common.h
index 0ab2a3f..27589a1 100644
--- a/common/common.h
+++ b/common/common.h
@@ -73,6 +73,22 @@ struct common_cpu_params {
     uint32_t poll                        = 50;      // Polling (busywait) level (0 - no polling, 100 - mostly polling)
 };
 
+// Bonsai-Oryon runtime profiles (--oryon-profile balanced|throughput|low-power|auto).
+// A profile only fills settings the user did not give explicitly.
+struct common_oryon_profile {
+    std::string name;
+    std::string source;          // "built-in heuristic" or the tuned profile file
+    int         n_threads       = -1;
+    int         n_threads_batch = -1;
+    int         poll            = -1;   // -1: keep the default
+    std::string cpu_mask;               // hex, empty: no affinity
+    bool        cpu_strict      = false;
+    std::string barrier_spin;           // exported as BONSAI_BARRIER_SPIN if that is unset; empty: keep
+};
+// returns false (and fills err) for an unknown profile name
+bool common_oryon_profile_resolve(const std::string & name, common_oryon_profile & out, std::string & err);
+int  common_oryon_available_cpus();
+
 int32_t common_cpu_get_num_physical_cores();
 int32_t common_cpu_get_num_math();
 
